class Sample:
    a = 30
    b = 50
    @classmethod                # decorator
    def M1(cls):                #cls = class refernce 
        cls.b = 100


    def M2(self):
        print(self)

obj1 = Sample()
obj2 = Sample()

obj1.M1()                   # <class '__main__.Sample'> # using object refernce calling class_method

Sample.M1()                 # access class methid using class_ref
print(obj1.b)           
print(obj1.b)
print(obj2.b)